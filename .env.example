# Google Gemini API key used by the RAG answering pipeline.
GOOGLE_API_KEY=

# Optional: the Gemini model that writes the answers (default gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional: the Gemini embedding model that indexes uploaded PDFs
# (default gemini-embedding-001). Changing it means re-uploading documents.
# EMBEDDING_MODEL=gemini-embedding-001

# Admin account created by `python init_db.py` (only if both are set).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Username for that admin account (defaults to "admin").
ADMIN_USERNAME=admin
